{
  "permissions": {
    "allow": [
      "Bash(pnpm build:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git mv:*)",
      "Bash(git log:*)"
    ],
    "deny": [
      "Bash(rm -rf *)",
      "Bash(rm -rf /)",
      "Bash(rm -rf .)",
      "Bash(rm -rf ~*)",
      "Bash(rm -rf $*)",
      "Bash(git push --force*)",
      "Bash(git push * --force*)",
      "Bash(git push -f*)",
      "Bash(git reset --hard*)",
      "Bash(git checkout -- .)",
      "Bash(git clean -f*)",
      "Bash(git clean -fd*)",
      "Bash(git branch -D *)",
      "Bash(git update-ref:*)",
      "Bash(git filter-branch:*)",
      "Bash(git filter-repo:*)",
      "Bash(git config:*)",
      "Bash(curl * | bash*)",
      "Bash(curl * | sh*)",
      "Bash(curl * | zsh*)",
      "Bash(curl * | python*)",
      "Bash(curl * | node*)",
      "Bash(wget * | bash*)",
      "Bash(wget * | sh*)",
      "Bash(eval *)",
      "Bash(npm publish*)",
      "Bash(pnpm publish*)",
      "Bash(npx *)",
      "Bash(chmod 777*)",
      "Bash(chmod -R 777*)",
      "Bash(chmod +x *)",
      "Bash(ssh *)",
      "Bash(scp *)",
      "Bash(rsync *)",
      "Bash(pm2 *)",
      "Bash(sudo *)",
      "Bash(doas *)",
      "Bash(su *)",
      "Bash(*> /dev/null*)",
      "Bash(cat /etc/passwd*)",
      "Bash(cat /etc/shadow*)",
      "Bash(cat *.env*)",
      "Bash(cat *.env)",
      "Bash(cat .env*)",
      "Bash(head *.env*)",
      "Bash(tail *.env*)",
      "Bash(less *.env*)",
      "Bash(more *.env*)",
      "Bash(cat ~/.ssh/*)",
      "Bash(cat ~/.aws/*)",
      "Bash(cat ~/.netrc*)",
      "Bash(cat ~/.npmrc*)",
      "Bash(env)",
      "Bash(printenv)",
      "Bash(echo $*SECRET*)",
      "Bash(echo $*KEY*)",
      "Bash(echo $*TOKEN*)",
      "Bash(echo $*PASSWORD*)",
      "Bash(echo $*PASSWD*)",
      "Bash(echo $*CREDENTIAL*)",
      "Bash(echo $*DATABASE_URL*)",
      "Bash(echo $*NEXTAUTH_SECRET*)",
      "Bash(export *SECRET*)",
      "Bash(export *KEY*)",
      "Bash(export *TOKEN*)",
      "Bash(set *SECRET*)",
      "Bash(history*)",
      "Bash(nc *)",
      "Bash(ncat *)",
      "Bash(socat *)",
      "Bash(telnet *)",
      "Bash(dd *)",
      "Bash(mkfs*)",
      "Bash(crontab *)",
      "Bash(launchctl *)",
      "Bash(systemctl *)",
      "Bash(service *)",
      "Bash(* --no-verify*)",
      "Bash(* --no-gpg-sign*)",
      "Bash(open http*)",
      "Bash(open https*)",
      "WebSearch",
      "WebFetch",
      "Read(/etc/shadow)",
      "Read(/etc/sudoers)",
      "Read(/etc/passwd)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/.gnupg/**)",
      "Read(~/.netrc)",
      "Read(~/.npmrc)",
      "Read(~/.pypirc)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/.git/config)",
      "Read(**/.git/hooks/**)",
      "Edit(**/.env)",
      "Edit(**/.env.*)",
      "Edit(**/CLAUDE.md)",
      "Edit(**/.github/workflows/**)",
      "Edit(**/.claude/settings.json)",
      "Edit(**/.git/**)",
      "Write(**/.env)",
      "Write(**/.env.*)",
      "Write(**/CLAUDE.md)",
      "Write(**/.github/workflows/**)",
      "Write(**/.claude/settings.json)",
      "Write(**/.git/**)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Read|Edit|Write|MultiEdit|NotebookEdit|WebFetch|WebSearch",
        "hooks": [
          {
            "type": "command",
            "command": "bash $CLAUDE_PROJECT_DIR/.claude/hooks/preflight.sh"
          }
        ]
      }
    ]
  }
}
